#!/usr/bin/env bash
# Otto CLI - Main entry point for Otto commands
#
# Usage: otto <command> [options]
#
# Available commands:
#   done              Terminate current session with cleanup
#   pre-flight-check  Validate environment before starting work
#   help              Show this help message
#
# Environment:
#   OTTO_DEBUG: Enable verbose debug output

set -euo pipefail

# Script directory and project root
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Debug flag
DEBUG="${OTTO_DEBUG:-0}"

# Logging functions
log_debug() {
    if [[ "$DEBUG" == "1" ]]; then
        echo "[DEBUG] $*" >&2
    fi
}

log_error() {
    echo "[ERROR] $*" >&2
}

# Show help message
show_help() {
    cat <<'EOF'
Otto - Agent workflow automation tool

Usage: otto <command> [options]

Available commands:
  done              Terminate current session with cleanup and validation
  pre-flight-check  Validate environment before starting work
  help              Show this help message

Use "otto <command> --help" for more information about a specific command.

Environment variables:
  OTTO_DEBUG=1    Enable verbose debug output

Examples:
  otto done                    # Terminate with completed mode (validates git state)
  otto done --mode escalated   # Terminate with escalated mode (skip validation)
  otto done --issue otto-123   # Explicitly specify issue ID
  otto pre-flight-check        # Validate environment before starting work

For more information, see AGENTS.md and README.md
EOF
}

# Main command dispatcher
main() {
    # No arguments provided
    if [[ $# -eq 0 ]]; then
        log_error "No command specified"
        show_help
        exit 1
    fi

    # Parse command
    local command="$1"
    shift

    case "$command" in
        done)
            log_debug "Executing 'otto done' with args: $*"
            exec "$SCRIPT_DIR/otto-done.sh" "$@"
            ;;
        pre-flight-check)
            log_debug "Executing 'otto pre-flight-check' with args: $*"
            exec "$SCRIPT_DIR/otto-pre-flight-check.sh" "$@"
            ;;
        help|--help|-h)
            show_help
            exit 0
            ;;
        *)
            log_error "Unknown command: '$command'"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

main "$@"
