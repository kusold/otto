#!/usr/bin/env bash
# Pre-commit hook to check if Cargo.nix is in sync with Cargo.lock
# This prevents committing outdated Cargo.nix files

set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
SCRIPT="$PROJECT_ROOT/bin/check-cargo-nix-sync.sh"

if [[ -x "$SCRIPT" ]]; then
  exec "$SCRIPT"
else
  echo "Error: $SCRIPT not found or not executable" >&2
  exit 1
fi
